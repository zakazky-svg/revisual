<div id="cookie-consent" class="cookie-consent" hidden>
  <div class="cookie-consent__box">
    <p>
      Používáme cookies pro měření návštěvnosti a reklamu (Google, Meta). Nezbytné cookies pro chod webu
      používáme vždy. Více v <a href="/ochrana-osobnich-udaju/">Ochraně osobních údajů</a>.
    </p>

    <details id="cookie-consent-details" class="cookie-consent__details">
      <summary>Nastavení</summary>
      <div class="cookie-consent__setting">
        <label>
          <input type="checkbox" checked disabled />
          Nezbytné cookies (vždy aktivní)
        </label>
        <label>
          <input type="checkbox" id="cookie-consent-stats" />
          Analytické a marketingové cookies (Google, Meta)
        </label>
      </div>
      <button type="button" id="cookie-consent-save" class="btn btn--secondary">Uložit nastavení</button>
    </details>

    <div class="cookie-consent__actions">
      <button type="button" id="cookie-consent-reject" class="btn btn--secondary">Odmítnout vše</button>
      <button type="button" id="cookie-consent-accept" class="btn btn--primary">Přijmout vše</button>
    </div>
  </div>
</div>

<style>
  .cookie-consent {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 200;
    padding: var(--space-md);
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }

  .cookie-consent__box {
    max-width: var(--container-max);
    margin-inline: auto;
  }

  .cookie-consent p {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .cookie-consent__details summary {
    cursor: pointer;
    font-weight: 600;
    margin-bottom: var(--space-sm);
  }

  .cookie-consent__setting {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: var(--space-sm);
  }

  .cookie-consent__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  @media (max-width: 63.99rem) {
    .cookie-consent {
      bottom: var(--mobile-cta-height);
    }
  }
</style>

<script>
  const STORAGE_KEY = 'revisual-cookie-consent';

  type Consent = { stats: boolean; ts: number };

  function readConsent(): Consent | null {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? (JSON.parse(raw) as Consent) : null;
    } catch {
      return null;
    }
  }

  function writeConsent(stats: boolean) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ stats, ts: Date.now() }));
    } catch {
      /* localStorage not available (private mode) — consent just won't persist */
    }
  }

  function loadGTM() {
    (function (w: any, d: Document, s: string, l: string, i: string) {
      w[l] = w[l] || [];
      w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      const f = d.getElementsByTagName(s)[0];
      const j = d.createElement(s) as HTMLScriptElement;
      j.async = true;
      j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
      f.parentNode?.insertBefore(j, f);
    })(window, document, 'script', 'dataLayer', 'GTM-WQ83T449');
  }

  function loadMetaPixel() {
    (function (f: any, b: Document, e: string, v: string) {
      if (f.fbq) return;
      const n: any = (f.fbq = function (...args: unknown[]) {
        n.callMethod ? n.callMethod.apply(n, args) : n.queue.push(args);
      });
      if (!f._fbq) f._fbq = n;
      n.push = n;
      n.loaded = true;
      n.version = '2.0';
      n.queue = [];
      const t = b.createElement(e) as HTMLScriptElement;
      t.async = true;
      t.src = v;
      const s = b.getElementsByTagName(e)[0];
      s.parentNode?.insertBefore(t, s);
    })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
    (window as any).fbq('init', '1263469951864393');
    (window as any).fbq('track', 'PageView');
  }

  let applied = false;
  function applyConsent(stats: boolean) {
    if (!stats || applied) return;
    applied = true;
    loadGTM();
    loadMetaPixel();
  }

  const banner = document.getElementById('cookie-consent');
  const details = document.getElementById('cookie-consent-details') as HTMLDetailsElement | null;
  const statsCheckbox = document.getElementById('cookie-consent-stats') as HTMLInputElement | null;

  function showBanner() {
    banner?.removeAttribute('hidden');
  }

  function hideBanner() {
    banner?.setAttribute('hidden', '');
  }

  function decide(stats: boolean) {
    writeConsent(stats);
    hideBanner();
    if (details) details.open = false;
    applyConsent(stats);
  }

  document.getElementById('cookie-consent-accept')?.addEventListener('click', () => decide(true));
  document.getElementById('cookie-consent-reject')?.addEventListener('click', () => decide(false));
  document.getElementById('cookie-consent-save')?.addEventListener('click', () => decide(!!statsCheckbox?.checked));

  document.addEventListener('click', (event) => {
    const target = (event.target as HTMLElement)?.closest('[data-action="open-cookie-settings"]');
    if (!target) return;
    const existing = readConsent();
    if (statsCheckbox) statsCheckbox.checked = existing?.stats ?? false;
    showBanner();
    if (details) details.open = true;
  });

  const existing = readConsent();
  if (existing === null) {
    showBanner();
  } else {
    applyConsent(existing.stats);
  }
</script>
