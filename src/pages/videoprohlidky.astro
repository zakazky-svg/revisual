---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import LiteYoutube from '../components/LiteYoutube.astro';
import PricingTable from '../components/PricingTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import cenik from '../content/cenik.json';
import faq from '../content/faq.json';
import { faqPageJsonLd } from '../lib/seo';

const videoPolozky = cenik.videoAFoceni.polozky.filter((p) => p.nazev.startsWith('Videoprohlídka'));
const faqStranky = faq.filter((item) => item.kategorie.includes('videoprohlidky'));
const faqJsonLd = faqPageJsonLd(faqStranky);

const videa = [
  { id: 'I34hUJpVgWc', title: 'Videoprohlídka nemovitosti' },
  { id: 'QSkKeQd8LTY', title: 'Videoprohlídka nemovitosti' },
  { id: 'KGVywRlp-iw', title: 'Videoprohlídka nemovitosti' },
];
---

<Layout
  title="Videoprohlídky nemovitostí – Ostrava, Praha, ČR"
  description="Profesionální videoprohlídky bytů a domů pro realitní makléře. Tři varianty zpracování, jasný ceník, rychlé dodání."
>
  {faqJsonLd && <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}

  <Section>
    <h1>Videoprohlídky nemovitostí – Ostrava, Praha a celá ČR</h1>
    <p class="lead">
      Natočíme dynamickou videoprohlídku, která nemovitost představí v nejlepším světle a zaujme zájemce
      dřív, než dorazí na místo.
    </p>
    <p class="locality">Působíme v Ostravě, Praze a po celé ČR.</p>
    <Button href="/kontakt/" variant="primary">Nezávazná poptávka</Button>
  </Section>

  <Section background="surface">
    <h2>Co služba zahrnuje</h2>
    <p>
      Nabízíme tři varianty zpracování: videoprohlídku bez mluveného slova, s mluveným slovem v pozadí
      a mluvené zpracování s výstupem. Konkrétní podobu přizpůsobíme typu nemovitosti a vašim požadavkům.
    </p>
    <h2>Pro koho je služba vhodná</h2>
    <p>
      Pro makléře, kteří chtějí inzerát odlišit od konkurence a přilákat víc vážných zájemců ještě před
      osobní prohlídkou.
    </p>
  </Section>

  <Section>
    <h2>Ukázky</h2>
    <div class="grid grid--videos">
      {videa.map((video) => (
        <LiteYoutube id={video.id} title={video.title} />
      ))}
    </div>
  </Section>

  <Section background="surface">
    <h2>Cena</h2>
    <div class="grid grid--pricing">
      <PricingTable nazev="Videoprohlídka" polozky={videoPolozky} />
    </div>
    <p class="section__note">Kompletní přehled najdete v <a href="/cenik/">ceníku</a>.</p>
  </Section>

  <Section>
    <h2>Časté dotazy</h2>
    <FaqAccordion items={faqStranky} />
  </Section>

  <Section background="dark">
    <div class="cta">
      <h2>Chcete nemovitost představit videem?</h2>
      <Button href="/kontakt/" variant="primary">Nezávazná poptávka</Button>
    </div>
  </Section>
</Layout>

<style>
  .lead {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 42rem;
    margin-bottom: var(--space-md);
  }

  .locality {
    font-weight: 600;
    margin-bottom: var(--space-md);
  }

  .grid {
    display: grid;
    gap: var(--space-md);
  }

  .grid--videos {
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .grid--pricing {
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    align-items: start;
  }

  .section__note {
    margin-top: var(--space-md);
    color: var(--color-text-muted);
  }

  .cta {
    text-align: center;
  }

  .cta h2 {
    margin-bottom: var(--space-md);
  }
</style>
