---
interface Props {
  ratio?: string;
  label?: string;
  class?: string;
}

const { ratio = '4 / 3', label = 'Obrázek doplníme', class: className } = Astro.props;
---

<div class:list={['placeholder-image', className]} style={`aspect-ratio: ${ratio}`} aria-hidden="true">
  <span>{label}</span>
</div>

<style>
  .placeholder-image {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    text-align: center;
    padding: var(--space-sm);
  }
</style>
