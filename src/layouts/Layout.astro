---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/og-image.jpg' } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const professionalService = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Revisual',
  url: 'https://revisual.cz',
  telephone: '+420732860641',
  email: 'zakazky@revisual.cz',
  taxID: '17632871',
  sameAs: ['https://www.instagram.com/revisual.cz/'],
  areaServed: [
    { '@type': 'City', name: 'Praha' },
    { '@type': 'City', name: 'Ostrava' },
    { '@type': 'Country', name: 'Česká republika' },
  ],
};
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="cs_CZ" />

    <script type="application/ld+json" set:html={JSON.stringify(professionalService)} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Přejít na obsah</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <MobileCta />
    <CookieConsent />
  </body>
</html>
