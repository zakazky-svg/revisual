---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';

const tym = [
  { jmeno: 'Alexandr Skýba', role: '[DOPLNIT role]', telefon: '+420 732 860 641' },
  { jmeno: 'Daniel Kresila', role: '[DOPLNIT role]', telefon: '+420 737 692 051' },
];
---

<Layout
  title="O nás – Revisual"
  description="Kdo jsme a jak pracujeme. Revisual – vizuální prezentace nemovitostí pro realitní makléře v Praze, Ostravě a celé ČR."
>
  <Section>
    <h1>O nás</h1>
    <p class="lead">
      Jsme Revisual, tým pro realitní makléře, který připravuje půdorysy, vizualizace, 3D prohlídky,
      videa a fotografie nemovitostí. Působíme v Praze a v Ostravě a rádi pracujeme pro klienty
      z celé republiky.
    </p>
    <p class="lead">
      Nebojíme se výzev, naopak je máme rádi. Každá nová zakázka nás posouvá dál a nemáme problém
      přizpůsobit se potřebám klienta, jeho termínům i způsobu práce. Naším cílem je, aby vaše
      nemovitost vypadala nejlépe, jak je to možné, a prodávala se rychleji.
    </p>
  </Section>

  <Section background="surface">
    <h2>Kdo jsme</h2>
    <div class="grid grid--tym">
      {tym.map((clovek) => (
        <div class="person">
          <PlaceholderImage ratio="1 / 1" label="Fotka doplníme" />
          <h3>{clovek.jmeno}</h3>
          <p class="person__role">{clovek.role}</p>
          <p><a href={`tel:${clovek.telefon.replace(/\s/g, '')}`}>{clovek.telefon}</a></p>
        </div>
      ))}
    </div>
  </Section>

  <Section>
    <h2>Kde působíme</h2>
    <p class="lead">
      Sídlíme v Praze a v Ostravě, ale služby zajišťujeme pro realitní makléře po celé ČR.
    </p>
    <div class="cta">
      <Button href="/kontakt/" variant="primary">Nezávazná poptávka</Button>
    </div>
  </Section>
</Layout>

<style>
  .lead {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 42rem;
    margin-bottom: var(--space-md);
  }

  .grid--tym {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    max-width: 40rem;
  }

  .person h3 {
    margin-top: var(--space-md);
    margin-bottom: 0.25rem;
  }

  .person__role {
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .cta {
    margin-top: var(--space-md);
  }
</style>
